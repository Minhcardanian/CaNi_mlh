use aiken/interval
use aiken/primitive/bytearray
use nightpermit/permit_v1

const relay_public_key =
  #"03a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8"

const gv_01_bytes =
  #""

const gv_01_signature =
  #"a3a37324659ec2552a1b0c3f0089eca965de2eb9cd95671e02c6c842da19e7dc36219c5623cd611950de3d9c0585119afbaed96dbc8b99928f7b4fb446159305"

const gv_02_bytes =
  #""

const gv_02_signature =
  #"f37738d99c51e8428812942d34302d648b4f04b6be69f68d0501551ed308ef62032a625a7d6035991d63ffcb45a445e77534817dde1b7c8922c753a7e24b7d05"

const gv_03_bytes =
  #""

const gv_01_policy =
  permit_v1.PermitPolicy {
    midnight_contract_id: #"1111111111111111111111111111111111111111111111111111111111111111",
    policy_id: #"3333333333333333333333333333333333333333333333333333333333333333",
    escrow_id: #"4444444444444444444444444444444444444444444444444444444444444444",
    milestone_id: #"5555555555555555555555555555555555555555555555555555555555555555",
    beneficiary_pkh: #"66666666666666666666666666666666666666666666666666666666",
    action_id: #"7777777777777777777777777777777777777777777777777777777777777777",
    asset_policy_id: #"",
    asset_name: #"",
    amount: 25_000_000,
    cardano_validator_hash: #"99999999999999999999999999999999999999999999999999999999",
    relay_key_id: #"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    relay_public_key,
  }

test decodes_gv_01() {
  let permit = permit_v1.decode(gv_01_bytes)
  permit.authorization_index == Some(7) && permit.policy_id == #"3333333333333333333333333333333333333333333333333333333333333333" && permit.asset_policy_id == #"" && permit.amount == 25_000_000 && permit.not_before_slot == Some(
    121_500_000,
  ) && permit.expires_at_slot == 121_503_600
}

test decodes_boundary_gv_02() {
  let permit = permit_v1.decode(gv_02_bytes)
  permit.authorization_index == Some(4_294_967_295) && bytearray.length(
    permit.asset_policy_id,
  ) == 28 && bytearray.length(permit.asset_name) == 32 && permit.amount == 18_446_744_073_709_551_615 && permit.not_before_slot == Some(
    18_446_744_073_709_551_615,
  ) && permit.expires_at_slot == 18_446_744_073_709_551_615
}

test verifies_gv_01_signature() {
  permit_v1.verify_signature(gv_01_bytes, gv_01_signature, relay_public_key)
}

test verifies_gv_02_signature() {
  permit_v1.verify_signature(gv_02_bytes, gv_02_signature, relay_public_key)
}

test rejects_tampered_gv_03_signature() {
  !permit_v1.verify_signature(gv_03_bytes, gv_01_signature, relay_public_key)
}

test rejects_trailing_data() fail {
  permit_v1.decode(bytearray.concat(gv_01_bytes, #"00")).amount >= 0
}

test rejects_unknown_version() fail {
  permit_v1.decode(
    #"",
  ).amount >= 0
}

test authorizes_exact_claim() {
  let not_before_ms = permit_v1.preview_slot_to_posix_ms(121_500_000)
  let expiry_ms = permit_v1.preview_slot_to_posix_ms(121_503_600)
  permit_v1.authorizes_claim(
    gv_01_policy,
    gv_01_bytes,
    gv_01_signature,
    [gv_01_policy.beneficiary_pkh],
    interval.between(not_before_ms, expiry_ms),
    [],
  )
}

test rejects_wrong_signer() {
  let not_before_ms = permit_v1.preview_slot_to_posix_ms(121_500_000)
  let expiry_ms = permit_v1.preview_slot_to_posix_ms(121_503_600)
  !permit_v1.authorizes_claim(
    gv_01_policy,
    gv_01_bytes,
    gv_01_signature,
    [#"00000000000000000000000000000000000000000000000000000000"],
    interval.between(not_before_ms, expiry_ms),
    [],
  )
}

test rejects_consumed_nullifier() {
  let not_before_ms = permit_v1.preview_slot_to_posix_ms(121_500_000)
  let expiry_ms = permit_v1.preview_slot_to_posix_ms(121_503_600)
  !permit_v1.authorizes_claim(
    gv_01_policy,
    gv_01_bytes,
    gv_01_signature,
    [gv_01_policy.beneficiary_pkh],
    interval.between(not_before_ms, expiry_ms),
    [#"8888888888888888888888888888888888888888888888888888888888888888"],
  )
}

test rejects_expired_validity_range() {
  let expiry_ms = permit_v1.preview_slot_to_posix_ms(121_503_600)
  !permit_v1.authorizes_claim(
    gv_01_policy,
    gv_01_bytes,
    gv_01_signature,
    [gv_01_policy.beneficiary_pkh],
    interval.between(expiry_ms + 1, expiry_ms + 1_000),
    [],
  )
}

test rejects_not_yet_valid_range() {
  let not_before_ms = permit_v1.preview_slot_to_posix_ms(121_500_000)
  !permit_v1.authorizes_claim(
    gv_01_policy,
    gv_01_bytes,
    gv_01_signature,
    [gv_01_policy.beneficiary_pkh],
    interval.between(not_before_ms - 1_000, not_before_ms - 1),
    [],
  )
}

test rejects_wrong_entitlement_policy() {
  let not_before_ms = permit_v1.preview_slot_to_posix_ms(121_500_000)
  let expiry_ms = permit_v1.preview_slot_to_posix_ms(121_503_600)
  !permit_v1.authorizes_claim(
    permit_v1.PermitPolicy { ..gv_01_policy, amount: 25_000_001 },
    gv_01_bytes,
    gv_01_signature,
    [gv_01_policy.beneficiary_pkh],
    interval.between(not_before_ms, expiry_ms),
    [],
  )
}
