{
  "name": "@nightpermit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:dependencies && tsc -p tsconfig.build.json && vite build",
    "build:dependencies": "npm run build --workspace=@nightpermit/cardano-client && npm run build --workspace=@nightpermit/permit",
    "check": "npm run build:dependencies && tsc -p tsconfig.json --noEmit",
    "test": "npm run build:dependencies && vitest run"
  },
  "dependencies": {
    "@lucid-evolution/core-types": "0.3.0",
    "@nightpermit/cardano-client": "0.1.0",
    "@nightpermit/permit": "0.1.0",
    "@scure/base": "2.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.2.0",
    "vite": "7.2.2"
  }
}
